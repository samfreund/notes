@startuml
title Trade Worker BPM Display
actor TradeWorker
participant "workStatusDisplay:WorkStatusDisplay" as WorkStatusDisplay
participant "heartRateController:HeartRateController" as HeartRateController
participant "healthDataRepo:HealthDataRepository" as HealthDataRepo
participant "healthServices:HealthServices" as HealthServices
participant "statsCalculator:StatisticsCalculator" as StatsCalculator
participant "dailyStats:DailyStatistics" as DailyStats

TradeWorker -> WorkStatusDisplay: glanceAtWatch()
WorkStatusDisplay -> WorkStatusDisplay: onResume()
WorkStatusDisplay -> HeartRateController: refreshHeartRateData()
HeartRateController -> HealthDataRepo: getCurrentHeartRate()
HealthDataRepo -> HealthServices: getLatestMeasurement(DataType.HEART_RATE_BPM)
HealthServices --> HealthDataRepo: dataPoint {timestamp: 1643970840000, value: 125.0}
HealthDataRepo -> HealthDataRepo: createHeartRateReading(dataPoint)
HealthDataRepo --> HeartRateController: currentReading {bpm: 125, timestamp: 1643970840000}
HeartRateController -> StatsCalculator: calculateDailyAverage(workerId)
StatsCalculator -> DailyStats: getTodaysReadings(workerId, startTime)
DailyStats --> StatsCalculator: readings [List size: 247 readings]
StatsCalculator -> StatsCalculator: computeAverage(readings)
note right of StatsCalculator
Filters outliers (>200 or <40), sums valid BPM values, divides by count
end note
StatsCalculator --> HeartRateController: averageBpm: 98.3
HeartRateController -> HeartRateController: createDisplayModel(current, average)
HeartRateController --> WorkStatusDisplay: displayModel {currentBpm: 125, avgBpm: 98, status: ELEVATED}
WorkStatusDisplay -> WorkStatusDisplay: updateBpmDisplay(model)
note right of WorkStatusDisplay
Updates TextView components, sets color based on status
end note
WorkStatusDisplay --> TradeWorker: Display shows "125 BPM", "Daily Avg: 98 BPM"
@enduml
